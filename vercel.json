{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/build_vercel.py",
  "outputDirectory": "vercel-dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.example.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.example.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://api.example.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://api.example.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
